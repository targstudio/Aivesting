# Token da brapi.dev (cotações com atraso; substituir por feed em tempo real quando contratado)
BRAPI_TOKEN=
# Chave da API da Anthropic para as explicações da IA
ANTHROPIC_API_KEY=
# Intervalo de recálculo do ranking, em minutos
RANKING_INTERVAL_MINUTES=5
# Origem do front-end liberada no CORS
WEB_ORIGIN=http://localhost:3000
# true = dados sintéticos, sem brapi nem Banco Central
DEMO_MODE=false
# Supabase (opcional): grava cada ranking para o histórico de acertos. Use a chave secreta (sb_secret_...).
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Produção: protege POST /ranking/recompute e limita chamadas à IA por IP
ADMIN_TOKEN=
AI_REQUESTS_PER_HOUR=30
# Fonte de cotações: yahoo (gratuito, uso não comercial) ou brapi (token; plano pago para todos os ativos)
DATA_PROVIDER=yahoo
